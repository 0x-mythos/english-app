# Telegram (BotFather)
TELEGRAM_BOT_TOKEN=
# Хто може користуватись, id через кому. Порожньо: на проді не пускає нікого
ALLOWED_TELEGRAM_IDS=
# Supabase (Project Settings → API Keys). Secret key (sb_secret_…) — ЛИШЕ сервер
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Anthropic
ANTHROPIC_API_KEY=
# Обов'язковий: без нього крон і webhook відмовляють
CRON_SECRET=
# Публічна https-адреса застосунку для кнопки в боті. Без неї бот відповідає без кнопки
PUBLIC_URL=
